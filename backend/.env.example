# Mode penyimpanan: auto | memory | postgres
# auto = pakai PostgreSQL bila tersedia, otherwise fallback ke memori.
DB_MODE=auto

# Kosongkan DATABASE_URL untuk memakai variabel PGHOST/PGPORT/PGDATABASE/PGUSER/PGPASSWORD.
# Contoh: postgresql://user:password@127.0.0.1:5432/pt_ade_pasir
DATABASE_URL=

PGHOST=127.0.0.1
PGPORT=5432
PGDATABASE=pt_ade_pasir
PGUSER=postgres
PGPASSWORD=

DB_POOL_MAX=5
DB_CONNECT_TIMEOUT_MS=3000
MAX_HISTORY=500

HOST=127.0.0.1
PORT=3000

# MQTT: 1 = aktif, 0 = nonaktif.
MQTT_DISABLED=1
MQTT_RECONNECT=0
MQTT_URL=mqtt://127.0.0.1:1883
MQTT_TOPIC=fleet/fe71/+/telemetry
